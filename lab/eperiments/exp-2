        "import csv\n",
        "\n",
        "# Read training data from CSV file\n",
        "with open(\"trainingdata.csv\", \"r\") as file:\n",
        "    data = list(csv.reader(file))\n",
        "\n",
        "# Remove header\n",
        "header = data[0]\n",
        "training_data = data[1:]\n",
        "\n",
        "# Separate attributes and target\n",
        "X = [row[:-1] for row in training_data]\n",
        "Y = [row[-1] for row in training_data]\n",
        "\n",
        "num_attributes = len(X[0])\n",
        "\n",
        "# Initialize Specific and General boundaries\n",
        "S = ['0'] * num_attributes\n",
        "G = [['?'] * num_attributes]\n",
        "\n",
        "# Check whether hypothesis covers an example\n",
        "def covers(h, example):\n",
        "    for i in range(num_attributes):\n",
        "        if h[i] != '?' and h[i] != example[i]:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "# Candidate-Elimination Algorithm\n",
        "for example, target in zip(X, Y):\n",
        "\n",
        "    # Positive example\n",
        "    if target == \"Yes\":\n",
        "\n",
        "        # Remove general hypotheses that do not cover positive example\n",
        "        G = [g for g in G if covers(g, example)]\n",
        "\n",
        "        # Update Specific boundary\n",
        "        for i in range(num_attributes):\n",
        "            if S[i] == '0':\n",
        "                S[i] = example[i]\n",
        "            elif S[i] != example[i]:\n",
        "                S[i] = '?'\n",
        "\n",
        "    # Negative example\n",
        "    else:\n",
        "\n",
        "        new_G = []\n",
        "\n",
        "        for g in G:\n",
        "            if covers(g, example):\n",
        "\n",
        "                # Generate minimal specializations\n",
        "                for i in range(num_attributes):\n",
        "                    if g[i] == '?':\n",
        "                        if S[i] != '?' and S[i] != '0':\n",
        "                            new_h = g.copy()\n",
        "                            new_h[i] = S[i]\n",
        "\n",
        "                            # Keep only hypotheses that do not cover negative example\n",
        "                            if not covers(new_h, example):\n",
        "                                new_G.append(new_h)\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "\n",
        "        G = new_G\n",
        "\n",
        "# Remove duplicate hypotheses\n",
        "G = [list(x) for x in set(tuple(g) for g in G)]\n",
        "\n",
        "# Display results\n",
        "print(\"Training Data:\")\n",
        "for row in training_data:\n",
        "    print(row)\n",
        "\n",
        "print(\"\\nSpecific Boundary (S):\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nGeneral Boundary (G):\")\n",
        "for g in G:\n",
        "    print(g)\n",
        "\n",
        "print(\"\\nAll Hypotheses Consistent with Training Data:\")\n",
        "print(\"S =\", S)\n",
        "print(\"G =\", G)"
