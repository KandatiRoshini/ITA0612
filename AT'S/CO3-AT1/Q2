        "# Maximum Likelihood Estimation (MLE) vs Bayesian Estimation\n",
        "# Dataset: Iris Dataset\n",
        "\n",
        "import numpy as np\n",
        "from sklearn.datasets import load_iris\n",
        "\n",
        "# -----------------------------\n",
        "# Load Dataset\n",
        "# -----------------------------\n",
        "iris = load_iris()\n",
        "\n",
        "# Use sepal length as sample data\n",
        "data = iris.data[:, 0]\n",
        "\n",
        "# -----------------------------\n",
        "# Small and Large Samples\n",
        "# -----------------------------\n",
        "small_sample = data[:20]\n",
        "large_sample = data\n",
        "\n",
        "# -----------------------------\n",
        "# MLE Estimation\n",
        "# -----------------------------\n",
        "def mle_estimate(sample):\n",
        "    mean = np.mean(sample)\n",
        "    variance = np.var(sample)   # MLE variance\n",
        "    return mean, variance\n",
        "\n",
        "# -----------------------------\n",
        "# Bayesian Estimation\n",
        "# Prior: Normal(mean=5, variance=1)\n",
        "# Known observation variance = 1\n",
        "# -----------------------------\n",
        "def bayesian_mean(sample, prior_mean=5.0, prior_variance=1.0, obs_variance=1.0):\n",
        "\n",
        "    n = len(sample)\n",
        "    sample_mean = np.mean(sample)\n",
        "\n",
        "    posterior_variance = 1 / ((1/prior_variance) + (n/obs_variance))\n",
        "\n",
        "    posterior_mean = posterior_variance * (\n",
        "        (prior_mean/prior_variance) +\n",
        "        (n*sample_mean/obs_variance)\n",
        "    )\n",
        "\n",
        "    return posterior_mean, posterior_variance\n",
        "\n",
        "# -----------------------------\n",
        "# Compare Results\n",
        "# -----------------------------\n",
        "for name, sample in [(\"Small Sample\", small_sample),\n",
        "                     (\"Large Sample\", large_sample)]:\n",
        "\n",
        "    print(\"=\"*60)\n",
        "    print(name)\n",
        "\n",
        "    mle_mean, mle_var = mle_estimate(sample)\n",
        "\n",
        "    bayes_mean, bayes_var = bayesian_mean(sample)\n",
        "\n",
        "    print(\"\\nMaximum Likelihood Estimation\")\n",
        "    print(\"Mean     :\", round(mle_mean,4))\n",
        "    print(\"Variance :\", round(mle_var,4))\n",
        "\n",
        "    print(\"\\nBayesian Estimation\")\n",
        "    print(\"Posterior Mean     :\", round(bayes_mean,4))\n",
        "    print(\"Posterior Variance :\", round(bayes_var,4))\n"
      ]
    }
