        "# Naïve Bayes Classifier on Iris Dataset\n",
        "# Compare different feature sets and Laplace smoothing\n",
        "\n",
        "import pandas as pd\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import KBinsDiscretizer\n",
        "from sklearn.naive_bayes import CategoricalNB\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, classification_report\n",
        "\n",
        "# -----------------------------\n",
        "# Load Real-world Dataset\n",
        "# -----------------------------\n",
        "iris = load_iris()\n",
        "\n",
        "X = pd.DataFrame(\n",
        "    iris.data,\n",
        "    columns=iris.feature_names\n",
        ")\n",
        "\n",
        "y = iris.target\n",
        "\n",
        "# -----------------------------\n",
        "# Convert Continuous Features\n",
        "# into Categorical Bins\n",
        "# -----------------------------\n",
        "discretizer = KBinsDiscretizer(\n",
        "    n_bins=4,\n",
        "    encode='ordinal',\n",
        "    strategy='uniform'\n",
        ")\n",
        "\n",
        "X_binned = discretizer.fit_transform(X)\n",
        "\n",
        "# -----------------------------\n",
        "# Different Feature Sets\n",
        "# -----------------------------\n",
        "feature_sets = {\n",
        "    \"All Features\":[0,1,2,3],\n",
        "    \"Sepal Features\":[0,1],\n",
        "    \"Petal Features\":[2,3]\n",
        "}\n",
        "\n",
        "print(\"=\"*60)\n",
        "\n",
        "for name, cols in feature_sets.items():\n",
        "\n",
        "    print(\"\\nFeature Set:\", name)\n",
        "\n",
        "    X_selected = X_binned[:, cols]\n",
        "\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X_selected,\n",
        "        y,\n",
        "        test_size=0.3,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    # -----------------------------\n",
        "    # Without Laplace Smoothing\n",
        "    # alpha = 0\n",
        "    # -----------------------------\n",
        "    model1 = CategoricalNB(alpha=0)\n",
        "\n",
        "    model1.fit(X_train, y_train)\n",
        "\n",
        "    pred1 = model1.predict(X_test)\n",
        "\n",
        "    acc1 = accuracy_score(y_test, pred1)\n",
        "    pre1 = precision_score(y_test, pred1, average='macro')\n",
        "    rec1 = recall_score(y_test, pred1, average='macro')\n",
        "\n",
        "    print(\"\\nWithout Laplace Smoothing\")\n",
        "    print(\"Accuracy :\", round(acc1,4))\n",
        "    print(\"Precision:\", round(pre1,4))\n",
        "    print(\"Recall   :\", round(rec1,4))\n",
        "\n",
        "    # -----------------------------\n",
        "    # With Laplace Smoothing\n",
        "    # alpha = 1\n",
        "    # -----------------------------\n",
        "    model2 = CategoricalNB(alpha=1)\n",
        "\n",
        "    model2.fit(X_train, y_train)\n",
        "\n",
        "    pred2 = model2.predict(X_test)\n",
        "\n",
        "    acc2 = accuracy_score(y_test, pred2)\n",
        "    pre2 = precision_score(y_test, pred2, average='macro')\n",
        "    rec2 = recall_score(y_test, pred2, average='macro')\n",
        "\n",
        "    print(\"\\nWith Laplace Smoothing\")\n",
        "    print(\"Accuracy :\", round(acc2,4))\n",
        "    print(\"Precision:\", round(pre2,4))\n",
        "    print(\"Recall   :\", round(rec2,4))\n",
        "\n",
        "    print(\"\\nClassification Report\")\n",
        "    print(classification_report(y_test, pred2))"
